{
  "name": "voice-router-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:runtime": "node --experimental-transform-types --test tests/runtime.test.mjs",
    "test:events": "node --experimental-transform-types --test tests/events.test.mjs",
    "test:tts": "node --experimental-transform-types --test tests/tts.test.mjs",
    "test:trace": "node --experimental-transform-types --test tests/trace.test.mjs",
    "test:integration": "node --experimental-transform-types --test tests/integration.test.mjs",
    "test:voice-bridge": "node --experimental-transform-types --test tests/voiceBridge.test.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:dashboard": "node --import tsx --test tests/dashboard.test.mjs tests/analytics.test.mjs",
    "format:dashboard": "prettier --check src/analytics src/components/dashboard src/components/ui src/lib server src/App.tsx src/styles.css src/conversation.css src/vite-env.d.ts vite.config.ts components.json tests/analytics.test.mjs tests/dashboard.test.mjs src/components/conversation/ConversationPanel.tsx index.html tsconfig.json package.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
