OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4.1-mini
# Optional separate conversation model; blank reuses OPENAI_ROUTER_MODEL.
OPENAI_RESPONSE_MODEL=
# Optional runtime-only synthetic Insurance client; personal phone stays in ignored .env.
DEMO_TEST_PHONE=
ROUTER_TIMEOUT_SECONDS=45
RISK_TIMEOUT_SECONDS=8
ROUTER_MAX_OUTPUT_TOKENS=2500
ROUTER_TEMPERATURE=0
ROUTER_ACCEPT_THRESHOLD=0.75
ROUTER_LOW_THRESHOLD=0.45
ROUTER_HANDOFF_AFTER=2
ROUTER_MAX_UNCLEAR_TURNS=3
ENABLE_DEV_STAND=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
STARTER_KIT_PATH=data/starter_kit
PRODUCT_CATALOG_PATH=data/product_promoter/catalog.json
EVENT_DB_PATH=data/runtime/veyra_events.db
