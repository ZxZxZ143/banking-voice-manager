OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4.1-mini
# Optional separate conversation model; blank reuses OPENAI_ROUTER_MODEL.
OPENAI_RESPONSE_MODEL=
# Optional runtime-only synthetic Insurance client; personal phone stays in ignored .env.
DEMO_TEST_PHONE=
ROUTER_TIMEOUT_SECONDS=45
RISK_TIMEOUT_SECONDS=8
ROUTER_MAX_OUTPUT_TOKENS=2500
ROUTER_TEMPERATURE=0
ROUTER_ACCEPT_THRESHOLD=0.75
ROUTER_LOW_THRESHOLD=0.45
ROUTER_HANDOFF_AFTER=2
ROUTER_MAX_UNCLEAR_TURNS=3
ENABLE_DEV_STAND=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
STARTER_KIT_PATH=data/starter_kit
PRODUCT_CATALOG_PATH=data/product_promoter/catalog.json
EVENT_DB_PATH=data/runtime/veyra_events.db
ANALYTICS_WINDOW_SECONDS=3600
ANALYTICS_BASELINE_WINDOWS=6
ANALYTICS_MIN_VOLUME=5
ANALYTICS_ANOMALY_MULTIPLIER=3

# Telephony — disabled until server-side credentials and signed callbacks are configured.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VONAGE_ENABLED=false
VONAGE_APPLICATION_ID=
# Local PEM path; keep key outside the repository/build context and mount read-only in Docker.
VONAGE_PRIVATE_KEY_PATH=
VONAGE_API_KEY=
VONAGE_SIGNATURE_SECRET=
# Exact allowed callback endpoints, digits only; no outbound dialing is included in Stage 6.
VONAGE_TEST_FROM_NUMBER=
VONAGE_TEST_TO_NUMBER=
# HTTPS origin without path/query; no tunnel is provisioned by this repository.
PUBLIC_BASE_URL=
# Shared browser/phone TTS. auto: configured OpenAI, otherwise browser fallback (web only).
# Local engines remain evaluation-only until RU + KK human listening approves them.
TTS_PROVIDER=auto
# Empty uses gpt-4o-mini-tts / cedar. No browser model or credential overrides.
BACKEND_TTS_MODEL=
BACKEND_TTS_VOICE=
# Empty uses concise application-owned professional RU/KK delivery instructions.
BACKEND_TTS_INSTRUCTIONS_RU=
BACKEND_TTS_INSTRUCTIONS_KK=
# Blank uses teammate's bounded 1200 ms phone endpoint setting.
PHONE_ENDPOINT_SILENCE_MS=
