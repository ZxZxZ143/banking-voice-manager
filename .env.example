OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=
ROUTER_TIMEOUT_SECONDS=45
ROUTER_MAX_OUTPUT_TOKENS=2500
ROUTER_ACCEPT_THRESHOLD=0.75
ROUTER_LOW_THRESHOLD=0.45
ROUTER_HANDOFF_AFTER=2
ROUTER_MAX_UNCLEAR_TURNS=3
ENABLE_DEV_STAND=false
BACKEND_HOST=
BACKEND_PORT=
FRONTEND_ORIGIN=

# Inbound Twilio bidirectional Media Streams (disabled until configured).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
BACKEND_TTS_MODEL=
BACKEND_TTS_VOICE=

# Vonage outbound trial demo; no rented number or API secret is required to dial.
VONAGE_ENABLED=false
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Dashboard signature secret (distinct from API secret); required for signed callbacks.
VONAGE_SIGNATURE_SECRET=
VONAGE_TEST_FROM_NUMBER=123456789
VONAGE_TEST_TO_NUMBER=

# Phone endpointing only; web keeps 2500 ms. Allowed range: 800-5000 ms.
PHONE_ENDPOINT_SILENCE_MS=1200

# Supervisor Data Intelligence: single-process, bounded in-memory analytics.
# Keep the supervisor token server-side; never expose it as a VITE variable.
ANALYTICS_ENABLED=false
ANALYTICS_API_TOKEN=
# Vite server-only local analytics target; restart Vite after changing analytics settings.
ANALYTICS_PROXY_TARGET=http://127.0.0.1:8000
ANALYTICS_DEMO_ENABLED=false
ANALYTICS_MAX_EVENTS=5000
ANALYTICS_WINDOW_SECONDS=3600
ANALYTICS_BASELINE_WINDOWS=6
ANALYTICS_MIN_VOLUME=5
ANALYTICS_ANOMALY_MULTIPLIER=3
